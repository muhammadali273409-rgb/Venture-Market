# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# This API's own public URL.
APP_URL=http://localhost:3000
# The deployed frontend's origin — used for CORS (src/main.ts) AND as the base
# of links in verification/password-reset emails ({FRONTEND_URL}/verify-email,
# {FRONTEND_URL}/reset-password — see src/integrations/email/email.service.ts).
FRONTEND_URL=http://localhost:3001
API_PREFIX=api/v1

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://venturemarket:changeme@localhost:5432/venturemarket_dev?schema=public

# ── Redis / Queues ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_REFRESH_TTL=30d
COOKIE_SECRET=change-me-to-a-long-random-string

# ── Object Storage (S3-compatible: AWS S3 / Cloudflare R2 / MinIO) ────────
# Files never touch the server's disk (Render's disk is wiped on deploy); the
# bucket stays private and downloads use short-lived signed URLs.
# Cloudflare R2: STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com,
# STORAGE_REGION=auto, keys from "R2 → Manage API tokens" (Object Read & Write).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=venturemarket-documents
STORAGE_ACCESS_KEY=changeme
STORAGE_SECRET_KEY=changeme
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL_SECONDS=300
# Server-side encryption header: empty for R2/MinIO (R2 always encrypts at
# rest), AES256 or aws:kms for AWS S3.
STORAGE_SSE=

# ── Email ────────────────────────────────────────────────────────────────
# console = only logged · resend = https://resend.com (needs a verified domain
# to email anyone but yourself) · brevo = https://brevo.com (a verified single
# sender address is enough — no domain needed).
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=VentureMarket <noreply@venturemarket.local>

# ── AI ───────────────────────────────────────────────────────────────────
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_MAX_REQUESTS_PER_DAY_FREE=5
AI_MAX_REQUESTS_PER_DAY_PRO=100

# ── Payments (Stripe) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Google Sign-In ───────────────────────────────────────────────────────
# OAuth 2.0 Client ID from the Google Cloud Console (an ID, not a secret —
# it's also read by the frontend as NEXT_PUBLIC_GOOGLE_CLIENT_ID, since
# Google Identity Services runs in the browser). Leave blank to disable
# "Continue with Google".
GOOGLE_CLIENT_ID=

# ── Rate limiting ────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ── Admin bootstrap (server-only — never NEXT_PUBLIC_*, never committed) ──
# Only read by `npm run admin:bootstrap` (prisma/scripts/bootstrap-admin.ts),
# never by the running API server. Set these temporarily to create/rotate
# the single Admin account, run the script, then unset them again — there is
# no other way to create an Admin account (registration can never produce
# one; see RegisterDto).
ADMIN_EMAIL=
ADMIN_PASSWORD=
